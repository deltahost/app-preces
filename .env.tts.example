AZURE_SPEECH_KEY=cole_sua_chave_aqui
AZURE_SPEECH_REGION=brazilsouth
TTS_PORT=8787
TTS_CACHE_TTL_SECONDS=3600
TTS_MAX_TEXT_LENGTH=5000
TTS_REQUEST_LIMIT=20
TTS_RATE_WINDOW_SECONDS=600

# Proteção opcional para testes. Em produção, a autorização deve ser validada
# pelo backend usando a assinatura do usuário; variáveis EXPO_PUBLIC não são secretas.
# TTS_API_TOKEN=troque-por-um-token-longo

# No app, use o IP local do computador, nunca localhost.
# EXPO_PUBLIC_TTS_API_URL=http://192.168.0.10:8787
# EXPO_PUBLIC_TTS_API_TOKEN=mesmo-token-de-teste
